# --- API ---
APP_NAME=Atrium
ENV=dev
API_PREFIX=/api/v1
# Obligatoire : le serveur refuse de demarrer sans. Generer la votre avec
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Hors ENV=dev, une valeur d'exemple ou de moins de 32 caracteres est refusee.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL (BD distante) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atrium
POSTGRES_USER=atrium
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://atrium:change-me@localhost:5432/atrium
